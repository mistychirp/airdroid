#!/data/data/com.termux/files/usr/bin/bash
# Moves playback to a fresh AAudio output after the output device changed (DAC
# plugged in or out), without ending shairport-sync's AirPlay session. The
# airplay_receiver module runs this through RUN_COMMAND. If PulseAudio doesn't
# cooperate, it restarts the receiver instead.

exec >> "$HOME/airplay-switch.log" 2>&1
echo "$(date '+%F %T') switching output"

p() { timeout 5 pactl "$@"; }

switch() {
  local new old_modules input module
  new=aaudio_$(date +%s)
  old_modules=$(p list short modules | awk '$2 == "module-aaudio-sink" {print $1}') || return 1
  p load-module module-aaudio-sink sink_name="$new" no_close_hack=1 > /dev/null || return 1
  p set-default-sink "$new" || return 1
  for input in $(p list short sink-inputs | cut -f1); do
    p move-sink-input "$input" "$new" || return 1
  done
  for module in $old_modules; do
    p unload-module "$module" || return 1
  done
}

if ! switch; then
  echo "switch failed, restarting the receiver"
  exec airplay-run
fi
