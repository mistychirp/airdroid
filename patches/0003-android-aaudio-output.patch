+++ b/audio_aaudio.c
@@ -0,0 +1,416 @@
+/*
+ * AAudio output driver for Android. This file is part of Shairport Sync.
+ *
+ * Writes to an AAudio stream from the player thread (blocking writes, no
+ * callback), so nothing else has to keep to the output's schedule. The delay
+ * comes from AAudio's presentation timestamps, which include the latency of
+ * the output device itself. When the output device changes (e.g. a USB DAC is
+ * plugged in or out), Android disconnects the stream; the next write opens a
+ * new one on the new default device and the session carries on.
+ *
