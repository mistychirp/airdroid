diff --git a/common.c b/common.c
index f041c22..73c6bb2 100644
--- a/common.c
+++ b/common.c
@@ -2232,6 +2232,21 @@ int get_device_id(uint8_t *id, int int_length) {
     *t++ = 0;
   }
 
+#ifdef __ANDROID__
+  // Android doesn't give apps MAC addresses, so the search below would wait
+  // its full ten seconds and give up. Take the address from the environment.
+  const char *env_mac = getenv("SPS_DEVICE_MAC");
+  if (env_mac) {
+    unsigned int b[6];
+    if (sscanf(env_mac, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) == 6) {
+      for (i = 0; i < 6 && i < int_length; i++)
+        id[i] = (uint8_t)b[i];
+      return 0;
+    }
+    warn("SPS_DEVICE_MAC \"%s\" is not a MAC address, ignoring it.", env_mac);
+  }
+#endif
+
   uint64_t wait_until = get_absolute_time_in_ns();
   wait_until = wait_until + wait_time;
 
